# Do not overwrite an existing .env.local containing a key.
# Needed only for collecting new Sectors snapshots; never expose via NEXT_PUBLIC_.
SECTORS_API_KEY=
# OpenAI server-only key for backend.ai.generate_structured (gpt-6-luna).
# Also supports root .env; never use NEXT_PUBLIC_AI_KEY.
AI_KEY=
# Frontend proxy target (optional; default shown)
BACKEND_URL=http://127.0.0.1:8000
# Server-to-server key: same value in Next.js and deployed FastAPI; never NEXT_PUBLIC_.
HORIZON_API_KEY=
# Set to 1 on deployed FastAPI to refuse startup with a missing/short key.
HORIZON_REQUIRE_API_KEY=
# Backend loads .env.local; exported process variables take precedence.
# Leave DATABASE_URL empty for local SQLite, or use direct/session PostgreSQL.
# The migration creates a limited horizon_app role and configures DATABASE_URL.
DATABASE_URL=
# Admin connection used only by the migration CLI. Never expose to the frontend.
MIGRATION_DATABASE_URL=
# Runtime role secret saved by migration for safe recovery; never commit its value.
HORIZON_DB_APP_PASSWORD=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
